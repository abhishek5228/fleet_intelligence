# Meta WhatsApp Business Cloud API access token
WHATSAPP_TOKEN=

# Your WhatsApp Business phone number ID
PHONE_NUMBER_ID=

# Powers all the AI understanding, diagnosis, vision, and language matching (Google Gemini)
GEMINI_API_KEY=

# Nearby workshop search, geocoding, and route calculation (Google Maps)
GOOGLE_MAPS_API_KEY=

# REQUIRED. Protects /api/triage and /api/send-whatsapp-interactive. If unset, those endpoints answer 503
# (they fail closed). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLEET_API_KEY=

# How long to wait before proactively checking in on a silent driver in seconds (default: 7200)
FOLLOWUP_CHECK_DELAY_SECONDS=

# How far back to look for repeat issues on the same vehicle in days (default: 90)
PREDICTIVE_PATTERN_WINDOW_DAYS=

# How many repeats before flagging a predictive-maintenance warning (default: 2)
PREDICTIVE_PATTERN_MIN_REPEATS=

# Optional: Alternative reranking provider and model overrides
COHERE_API_KEY=
GEMINI_VISION_MODEL=
GEMINI_GRADER_MODEL=

# Optional: Observability & OpenTelemetry / LangSmith tracing
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGCHAIN_TRACING_V2=
LANGCHAIN_PROJECT=

# REQUIRED. Meta App Secret — every webhook POST must carry a valid X-Hub-Signature-256 (Meta App Dashboard → Settings → Basic).
# If unset, webhook POSTs are refused with 503.
WHATSAPP_APP_SECRET=

# REQUIRED. Token for Meta's webhook handshake; use the same value in Meta's console. If unset, the handshake is refused.
WHATSAPP_VERIFY_TOKEN=

# Comma-separated CORS origins, e.g. https://your-app.vercel.app (default: any origin)
ALLOWED_ORIGINS=

# REQUIRED. The fleet manager's WhatsApp number with country code, e.g. +91XXXXXXXXXX.
# Only this number may press Approve / Reject / Pick-vendor buttons.
MANAGER_WHATSAPP_NUMBER=

# Who is who. JSON, either here or in the file named by FLEET_CONFIG_FILE (keep that file out of git).
# vehicle id -> driver WhatsApp number
DRIVER_WHATSAPP_MAPPING=
# Testing only: [{"name": "Vendor 1", "phone": "+91..."}]  (leave empty to use real nearby hubs)
TEST_VENDOR_NUMBERS=
# Testing only: ["+91..."]  (leave empty to use real hub phone numbers)
TEST_HUB_NUMBERS=
# Optional: path to a JSON file holding the three settings above
FLEET_CONFIG_FILE=

# Where the SQLite state file lives (default: backend/fleet_state.db). Put it on a persistent disk.
FLEET_DB_PATH=

# Diagnostics. Both default to OFF.
# Exposes /api/debug-pending-quotes, /api/debug-clear-pending-quotes and /api/test-gemini (still need the API key).
ENABLE_DEBUG_ENDPOINTS=
# Local development ONLY: lets requests through when FLEET_API_KEY / WHATSAPP_APP_SECRET /
# MANAGER_WHATSAPP_NUMBER are unset. Never set this in production.
ALLOW_INSECURE_DEV=
